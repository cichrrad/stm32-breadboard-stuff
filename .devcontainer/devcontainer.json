{
    "name": "STM32G4-Embedded-Env",
    "image": "mcr.microsoft.com/devcontainers/cpp:ubuntu-22.04",
    
    "runArgs": [
        "--privileged"
    ],
    "mounts": [
        "source=/dev,target=/dev,type=bind"
    ],
    
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "marus25.cortex-debug",
                "ms-vscode.makefile-tools"
            ]
        }
    },
    
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y gcc-arm-none-eabi gdb-multiarch build-essential cmake make openocd stlink-tools"
}